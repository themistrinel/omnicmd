{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "omnicmd",
  "version": "0.1.1",
  "identifier": "com.omnicmd.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OmniCmd",
        "url": "index.html",
        "width": 800,
        "height": 560,
        "minWidth": 800,
        "minHeight": 560,
        "maxWidth": 800,
        "maxHeight": 560,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": false,
        "windowEffects": {
          "effects": [
            "hudWindow",
            "acrylic",
            "blur"
          ],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: tauri:; img-src 'self' asset: https://asset.localhost tauri: data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: tauri: http://localhost:* ws://localhost:* https://api.github.com https://*; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NEUxQzdDNEFGMEY5RUUKUldUdStmQktmQnhPbUFycTJLOVREYmt2UWhETXovZElsclJXQzVWeVlyckZHVGRzMUdTbUdmZDAK",
      "endpoints": [
        "https://github.com/themistrinel/omnicmd/releases/latest/download/latest.json"
      ]
    }
  }
}
