{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "omnicmd",
  "version": "0.1.0",
  "identifier": "com.omnicmd.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OmniCmd",
        "width": 800,
        "height": 560,
        "minWidth": 800,
        "minHeight": 560,
        "maxWidth": 800,
        "maxHeight": 560,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["hudWindow", "acrylic", "blur"],
          "state": "active",
          "radius": 16.0
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/omnicmd/omnicmd/releases/latest/download/latest.json"
      ]
    }
  }
}
